[Unit]
Description=Sharing Vision Gateway Service
After=network.target article.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/sharing-vision-backend
EnvironmentFile=/opt/sharing-vision-backend/.env
ExecStart=/opt/sharing-vision-backend/gateway
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/sharing-vision-backend
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
